# FinSentinel AI Environment Configuration
# Copy to .env for local execution. Never commit real secrets to Git.

# Application
APP_ENV=local
SERVER_PORT=8080
# Comma-separated allowed CORS origins/patterns (e.g. https://your-app.vercel.app,https://*.vercel.app)
FRONTEND_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# PostgreSQL / Supabase
# Local Postgres uses POSTGRES_HOST/PORT/DB below.
# For your live Supabase project (Project Ref: jcpbjzywqzghkcmxobni):
# Direct: DATABASE_URL=jdbc:postgresql://db.jcpbjzywqzghkcmxobni.supabase.co:5432/postgres?sslmode=require
# Pooler: DATABASE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finsentinel
POSTGRES_USER=finsentinel
POSTGRES_PASSWORD=finsentinel_dev_local_change_me
# DATABASE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_POOL_MAX=10
DB_POOL_MIN=2

# Session & Security
SESSION_COOKIE_NAME=FS_SESSION
# Set SESSION_COOKIE_SECURE=true and SESSION_COOKIE_SAMESITE=None when frontend (Vercel) and backend are on different HTTPS origins
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_TTL_MINUTES=480
CSRF_COOKIE_NAME=XSRF-TOKEN

# Mailpit / SMTP (local test mail service)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@finsentinel.local
MAIL_ENABLED=true

# AI Provider Integration (server-side only; never expose to frontend)
# Supported: nvidia | mistral | openai | gemini | anthropic | local
# Failover: When multiple NVIDIA keys are set, FinSentinel tries NVIDIA keys 1->2->3 and falls back to Mistral ONLY if all NVIDIA keys fail.
AI_PROVIDER=nvidia
AI_MODEL=meta/llama-3.1-70b-instruct
MISTRAL_MODEL=mistral-large-latest
AI_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
AI_RAG_ENABLED=true
NVIDIA_API_KEY=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_API_KEYS=
MISTRAL_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_LOCAL_BASE_URL=
AI_REQUEST_TIMEOUT=30000
AI_MAX_OUTPUT_TOKENS=1024

# Demo / Seeding
DEMO_SEED_ENABLED=true
